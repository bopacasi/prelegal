# Copy to .env (which git ignores) and fill in. scripts/start.sh passes it to the backend.

# OpenRouter API key for the AI assistant (https://openrouter.ai/settings/keys).
# Without a key the app runs, but the assistant is unavailable.
OPENROUTER_API_KEY=

# The default model is OpenRouter's Free Models Router: no credits needed, but
# free models vary in quality and speed and are rate-limited.
# LLM_MODEL=openrouter/openrouter/free

# Paid alternative (needs OpenRouter credits): gpt-oss-120b, served only by Cerebras.
# LLM_MODEL=openrouter/openai/gpt-oss-120b
# LLM_PROVIDER=cerebras

# LLM_TIMEOUT_SECONDS=30

# FAKE_LLM is for tests only (scripts/test.sh sets it). Leave it unset here.
